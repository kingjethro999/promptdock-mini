# Prompt Dock Mini — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).

# --- Provider keys: at least ONE is required ---
APMIX_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Chain behavior (optional; defaults shown) ---
# Fallback order, comma-separated
AI_PROVIDER_ORDER=apmix,groq,gemini
# Max provider attempts per request
AI_MAX_FALLBACKS=2
# Per-provider timeout in milliseconds
AI_REQUEST_TIMEOUT_MS=12000

# --- Per-provider overrides (optional; defaults built into lib/ai.ts) ---
# APMIX_BASE_URL=https://api.apmix.ai/v1
# APMIX_MODEL=deepseek-v4-flash-free
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
